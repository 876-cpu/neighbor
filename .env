# Copy this file to .env and fill in real values. Never commit .env.

# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bd625b0eb54f99a5e44f9495606b172f13d0687facfa7c09820b373c3643b604cf421771deabf222a5072c1ddfd75332

# Port the server listens on
PORT=3000

# Comma-separated list of origins allowed to call the API (your frontend URL)
CORS_ORIGIN=http://localhost:3000

# Set to "production" when deployed behind HTTPS
NODE_ENV=development

# One-time setup token used to create the single seller/admin account.
# Generate a random value, set it here, use it once at /api/auth/setup-seller, then remove/rotate it.
SELLER_SETUP_TOKEN=neighbor123
